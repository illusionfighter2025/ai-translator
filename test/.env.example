# Copy to .env (or set in your shell) before running the e2e test.
# Never commit real values — .env is gitignored.

AIT_TEST_API_KEY=sk-your-key-here
AIT_TEST_BASE_URL=https://api.deepseek.com
AIT_TEST_MODEL=deepseek-v4-flash

# Optional: override the browser binary used by the e2e test.
# AIT_TEST_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Optional: override the extension directory (defaults to the project root).
# AIT_TEST_EXT_DIR=
